        "path": "trainer_samples_v3/source=deviantart",
        "n_samples": null
      },
      "e621": {
        "path": "trainer_samples_v3/source=e621",
        "n_samples": null
      },
      "midjourney": {
        "path": "trainer_samples_v3/source=midjourney",
        "n_samples": null
      },
      "reddit": {
        "path": "trainer_samples_v3/source=reddit",
        "n_samples": null
      }
    },
    "caption_columns": {
      "tags": {
        "weight": 1.0,
        "is_tag_based": true
